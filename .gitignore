:root {
  --bg: #07111f;
  --panel: rgba(13, 19, 31, 0.84);
  --panel-strong: #121b2b;
  --panel-soft: #171d29;
  --text: #edf3ff;
  --muted: #a9b7cf;
  --line: rgba(255, 255, 255, 0.08);
  --shadow: rgba(0, 0, 0, 0.28);
  --brand: #7c5cff;
  --brand-2: #5de2d2;
  --warm: #f59e0b;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(124, 92, 255, 0.2), transparent 26%),
    radial-gradient(circle at bottom right, rgba(93, 226, 210, 0.14), transparent 30%),
    var(--bg);
  color: var(--text);
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
  cursor: pointer;
}

img {
  max-width: 100%;
  display: block;
}

.app-shell {
  width: min(1280px, calc(100% - 48px));
  margin: 0 auto;
  padding: 32px 0 72px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 6px;
}

.brand-wrap {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-weight: 700;
}

.brand-mark {
  width: 30px;
  height: 30px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--brand), #a78bfa);
  color: white;
  box-shadow: 0 12px 30px rgba(124, 92, 255, 0.5);
}

.brand-text {
  letter-spacing: -0.04em;
}

.topnav {
  display: inline-flex;
  align-items: center;
  gap: 28px;
  color: var(--muted);
  font-size: 0.95rem;
}

.ghost-button,
.secondary-button,
.primary-button,
.mini-button,
.preset {
  border: 1px solid var(--line);
  border-radius: 14px;
  transition: 0.2s ease;
}

.ghost-button,
.secondary-button,
.mini-button {
  background: rgba(255, 255, 255, 0.02);
  color: var(--text);
}

.ghost-button {
  padding: 11px 18px;
}

.primary-button {
  background: linear-gradient(135deg, var(--brand), #9d7bff);
  border: none;
  color: white;
  padding: 14px 22px;
  font-weight: 600;
  box-shadow: 0 18px 40px rgba(124, 92, 255, 0.38);
}

.primary-button.compact,
.secondary-button.compact {
  padding: 10px 14px;
}

.secondary-button {
  padding: 14px 20px;
  background: rgba(255, 255, 255, 0.03);
}

.mini-button {
  padding: 8px 12px;
  font-size: 0.75rem;
  color: var(--muted);
}

.main-layout {
  display: grid;
  gap: 72px;
  padding-top: 26px;
}

.hero-section {
  display: grid;
  grid-template-columns: 1.02fr 1.18fr;
  gap: 42px;
  align-items: center;
}

.hero-copy {
  display: grid;
  gap: 20px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(124, 92, 255, 0.12);
  border: 1px solid rgba(124, 92, 255, 0.2);
  color: #d7ccff;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.hero-copy h1 {
  margin: 0;
  font-size: clamp(3rem, 5vw, 5rem);
  line-height: 0.96;
  letter-spacing: -0.07em;
}

.hero-copy p {
  max-width: 560px;
  margin: 0;
  color: var(--muted);
  font-size: 1.07rem;
  line-height: 1.75;
}

.cta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px;
  margin-top: 6px;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(120px, 1fr));
  gap: 14px;
  margin-top: 14px;
}

.stat-card {
  padding: 14px 16px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.02);
  display: grid;
  gap: 6px;
}

.stat-card strong {
  font-size: 1.6rem;
  letter-spacing: -0.05em;
}

.stat-card span {
  color: var(--muted);
  font-size: 0.8rem;
}

.editor-panel {
  background: linear-gradient(180deg, rgba(17, 23, 34, 0.96), rgba(11, 17, 27, 0.98));
  border: 1px solid var(--line);
  border-radius: 32px;
  padding: 20px;
  box-shadow: 0 18px 60px var(--shadow);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.panel-pill {
  display: inline-flex;
  background: rgba(93, 226, 210, 0.12);
  border: 1px solid rgba(93, 226, 210, 0.16);
  color: #bbf7ee;
  padding: 7px 10px;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 600;
}

.image-stage {
  position: relative;
  min-height: 480px;
  border-radius: 24px;
  border: 1px solid var(--line);
  background:
    linear-gradient(135deg, rgba(124, 92, 255, 0.12), rgba(93, 226, 210, 0.06)),
    rgba(255, 255, 255, 0.02);
  display: grid;
  place-items: center;
  overflow: hidden;
}

.image-stack {
  position: relative;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #0d1625, #111d2e);
}

.upload-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(1.08) contrast(1.06);
}

.transparent-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(135deg, rgba(15, 18, 26, 0.08), rgba(15, 18, 26, 0.28)),
    linear-gradient(90deg, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.8) 100%);
  background-size: 100% 100%;
  border: 3px solid;
  mix-blend-mode: screen;
}

.empty-state {
  display: grid;
  place-items: center;
  gap: 12px;
  padding: 18px;
  text-align: center;
  color: var(--muted);
}

.empty-icon {
  width: 62px;
  height: 62px;
  border-radius: 20px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, rgba(124, 92, 255, 0.2), rgba(93, 226, 210, 0.18));
  font-size: 2rem;
}

.tool-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-top: 18px;
  flex-wrap: wrap;
}

.preset-group,
.action-group {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.preset {
  padding: 10px 12px;
  background: rgba(255, 255, 255, 0.02);
  color: var(--muted);
  border-color: var(--line);
}

.preset.active {
  color: white;
  background: rgba(124, 92, 255, 0.12);
  border-color: rgba(124, 92, 255, 0.4);
}

.features-section,
.workflow-section {
  display: grid;
  gap: 28px;
}

.section-heading {
  display: grid;
  gap: 8px;
}

.section-heading h2 {
  margin: 0;
  font-size: clamp(2rem, 3vw, 3rem);
  letter-spacing: -0.06em;
}

.narrow {
  max-width: 620px;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(220px, 1fr));
  gap: 20px;
}

.feature-card,
.workflow-step {
  padding: 24px;
  border: 1px solid var(--line);
  border-radius: 26px;
  background: rgba(255, 255, 255, 0.02);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02);
}

.feature-icon {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, rgba(124, 92, 255, 0.18), rgba(93, 226, 210, 0.18));
  border: 1px solid rgba(124, 92, 255, 0.2);
  border-radius: 12px;
  font-size: 1.3rem;
  margin-bottom: 18px;
}

.feature-card h3,
.workflow-step h3 {
  margin: 0 0 12px;
  font-size: 1.3rem;
}

.feature-card p,
.workflow-step p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.workflow-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(220px, 1fr));
  gap: 20px;
}

.workflow-step span {
  display: inline-flex;
  margin-bottom: 18px;
  padding: 8px 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.04);
  color: #d7ccff;
  border: 1px solid var(--line);
  font-weight: 700;
}

.pricing-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 26px 28px;
  border: 1px solid var(--line);
  border-radius: 28px;
  background: linear-gradient(135deg, rgba(124, 92, 255, 0.12), rgba(93, 226, 210, 0.08));
}

.pricing-banner h3 {
  margin: 12px 0 0;
  font-size: clamp(1.4rem, 3vw, 2.2rem);
  letter-spacing: -0.05em;
}

@media (max-width: 980px) {
  .hero-section,
  .feature-grid,
  .workflow-grid {
    grid-template-columns: 1fr;
  }

  .topnav {
    display: none;
  }
}

@media (max-width: 620px) {
  .app-shell {
    width: min(100% - 28px, 1280px);
  }

  .hero-copy h1 {
    font-size: 2.5rem;
  }

  .stat-grid {
    grid-template-columns: 1fr;
  }

  .pricing-banner {
    flex-direction: column;
    align-items: flex-start;
  }
}
